# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage
/playwright-report/
/test-results/
/blob-report/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Recorded video. The script and shot list are committed; the encode is a generated artifact
# rebuilt deterministically by `npm run record:video`, so it is not carried in git history.
/.video-frames/
/media/*.mp4

# Working captures from the visual review harness. The final set is committed deliberately.
/media/review-*/
/media/chapters-*/
/media/sections-*/
# Full-page 2x captures: ~26MB, kept local rather than committed to the history.
/media/mob-*/
/media/case-01/
/media/g3/
/media/g4/
/media/g5/
/media/g6/
/media/r3/
/media/e3/
/media/hero*/
/media/v2/
/media/v3/
/media/v4/
/media/mob/
/media/final/
# Generated showreel: 2.8MB, re-recordable from tools/record-showreel.mjs.
/media/showreel.webm
/media/eng-*/
/media/routes-*/
/media/hyd/
/media/sf/
/media/cf/
/media/after-rks3/
/media/after-rks2/
/media/after-rks/
/media/after-insure/
/media/after-medico2/
/media/after-medico/
/media/before-rks/
/media/before-insure/
/media/before-medico/
/media/audit/
/media/final2/
/media/story-*/

# Generator cache: fetched from the streamflow repository on demand.
tools/.streamflow-cache/

# Generator cache: CIFAR-10 download and fetched repository artifacts.
tools/.cifar-cache/

# Generator preview, for looking at while tuning the synthetic radiograph.
tools/.medico-preview.png

# Geometry exported from the site's own modules for the offline frame renderer. Derived, not
# source: regenerate with `npx tsx tools/export-geometry.mjs`.
/tools/.geometry/

# Fetched repository trees for the source audit. Regenerate with tools/.audit/fetch.mjs.
/tools/.audit/repos.json
/media/motion/
