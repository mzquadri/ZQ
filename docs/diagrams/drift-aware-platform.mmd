%% A retraining loop that watches what it predicts
%% The monitors read production traffic, so they sit after the service rather than beside the data. The two signals are separate because they disagree - the inputs barely move and the target moves a long way past its threshold.
%%
%% Generated by scripts/export-diagrams.ts from src/content/diagrams/.
%% Do not edit: the next export overwrites it.
%%
%% Shapes: ([source]) [process] [(store)] {{gate}} [/artifact/] [[sink]]
%% Arrows: --> data   ==> control   -.-> feedback or refused
flowchart LR
  dataset(["Pinned dataset"])
  challenger{{"Challenger gate"}}
  alias[("Champion alias")]
  service[["Prediction service"]]
  subgraph col4 [" "]
    direction TB
    featuredrift["Feature drift"]
    targetdrift["Target drift"]
  end
  decide{{"Retrain decision"}}

  dataset --> challenger
  challenger -->|"clears the gate"| alias
  alias ==>|"loaded"| service
  service -->|"serving window"| featuredrift
  service --> targetdrift
  featuredrift ==> decide
  targetdrift ==> decide
  decide -.->|"retrain on either signal"| challenger

  style col4 fill:none,stroke:none
