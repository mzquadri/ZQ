%% Three derived forms, each checked against the capture
%% Checking the derived forms against each other finds disagreement without identifying who is wrong; re-deriving tests the derivation against itself. Verification here runs backwards to the evidence, and a failure is rebuilt rather than patched.
%%
%% Generated by scripts/export-diagrams.ts from src/content/diagrams/.
%% Do not edit: the next export overwrites it.
%%
%% Shapes: ([source]) [process] [(store)] {{gate}} [/artifact/] [[sink]]
%% Arrows: --> data   ==> control   -.-> feedback or refused
flowchart LR
  capture(["Captured source"])
  derive["Derived three ways"]
  subgraph col2 [" "]
    direction TB
    index[("Index")]
    graph[("Graph")]
    cache[("Cache")]
  end
  verify{{"Checked backwards"}}
  rebuild[["Rebuilt from evidence"]]

  capture --> derive
  derive --> index
  derive --> graph
  derive --> cache
  index ==> verify
  graph ==> verify
  cache ==> verify
  verify -->|"on disagreement"| rebuild
  verify -.->|"against the retained bytes"| capture
  rebuild -.->|"made again, not patched"| derive

  style col2 fill:none,stroke:none
